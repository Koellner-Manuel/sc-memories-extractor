# Personal data - never upload
# (the Snapchat export with its download links, and every saved memory)
export/*
!export/.gitkeep
output/*
!output/.gitkeep

# Portable tools - downloaded by 1_setup.cmd (~480 MB)
tools/

# Leftovers of aborted runs
~tmp_*
*_exiftool_tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors, OS, tooling
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
.DS_Store
